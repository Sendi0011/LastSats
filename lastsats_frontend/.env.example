# LastSats Frontend Environment Variables

# Stacks Network Configuration
# Set to "testnet" for testnet, or omit/set to "mainnet" for mainnet
NEXT_PUBLIC_STACKS_NETWORK=testnet

# WalletConnect (mobile wallet connect)
# Free project ID from https://dashboard.reown.com. Required for connecting an
# already-installed Xverse/Leather wallet from a normal mobile browser. If unset,
# the app still works but mobile users are only guided into the wallet's in-app
# browser. Safe to expose: this is a public identifier, not a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin used in the WalletConnect app metadata. Optional — it defaults
# to the browser origin, which is correct for production and preview deploys.
# NEXT_PUBLIC_SITE_URL=https://lastsats.app

# LastSats Contract Address
# Format: SP1234...ABCD.contract-name
# Leave empty or comment out to use mock mode for development/testing
# NEXT_PUBLIC_LASTSATS_CONTRACT_ADDRESS=SP1A1JTM2AXXXXXXXXXXXXXXXXXXXXXXXXXXX.lastsats-vault

# Example for testnet:
# NEXT_PUBLIC_LASTSATS_CONTRACT_ADDRESS=ST1234567890ABCDEFGHIJKLMNOPQRSTUV.lastsats-vault

# Example for mainnet:
# NEXT_PUBLIC_LASTSATS_CONTRACT_ADDRESS=SP1234567890ABCDEFGHIJKLMNOPQRSTUV.lastsats-vault

# ---------------------------------------------------------------------------
# Waitlist storage (Supabase) — SERVER ONLY. Do NOT prefix with NEXT_PUBLIC_.
# Create a Supabase project, run supabase/schema.sql, then paste the project
# URL and the service_role key (Project Settings → API). The service_role key
# bypasses RLS, so it must never be exposed to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Waitlist admin dashboard (/admin)
# ADMIN_PASSWORD: the password you type to open the dashboard.
# ADMIN_SESSION_SECRET: any long random string used to sign the login cookie.
#   Generate one with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=